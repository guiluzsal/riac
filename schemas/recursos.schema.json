{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/riac/riac/schemas/recursos.schema.json",
  "title": "Recursos do RIAC",
  "description": "Schema de validação para data/recursos.yaml, conforme o modelo de dados definido em CLAUDE.md.",
  "type": "array",
  "minItems": 1,
  "items": {
    "$ref": "#/$defs/recurso"
  },
  "$defs": {
    "recurso": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nome",
        "url",
        "descricao",
        "categoria",
        "idioma",
        "fase_ciclo",
        "verificado_em"
      ],
      "properties": {
        "nome": {
          "type": "string",
          "minLength": 1,
          "description": "Nome do recurso."
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://",
          "description": "URL canônica do recurso."
        },
        "descricao": {
          "type": "string",
          "minLength": 1,
          "description": "Descrição objetiva do recurso, em português."
        },
        "categoria": {
          "type": "string",
          "description": "Categoria principal do recurso. Cada recurso tem exatamente uma categoria; use tags para aspectos secundários.",
          "enum": [
            "varredura",
            "ip",
            "dominio",
            "ioc",
            "malware",
            "ator",
            "ransomware",
            "hacktivismo",
            "vazamentos",
            "vulnerabilidade",
            "ferramenta"
          ]
        },
        "idioma": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
          },
          "description": "Códigos de idioma do recurso (ex.: en, pt, pt-BR)."
        },
        "fase_ciclo": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "direcao",
              "coleta",
              "processamento",
              "analise",
              "disseminacao",
              "feedback"
            ]
          },
          "description": "Fase(s) do ciclo de inteligência em que o recurso é mais útil."
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Tags livres para aspectos secundários (ex.: categorias alternativas, brasil)."
        },
        "verificado_em": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Data da última verificação manual do recurso (AAAA-MM-DD)."
        }
      }
    }
  }
}
