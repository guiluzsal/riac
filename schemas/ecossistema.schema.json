{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/riac/riac/schemas/ecossistema.schema.json",
  "title": "Ecossistema do RIAC",
  "description": "Schema de validação para data/ecossistema.yaml, conforme o modelo de dados definido em CLAUDE.md.",
  "type": "array",
  "minItems": 1,
  "items": {
    "$ref": "#/$defs/item"
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nome",
        "url",
        "descricao",
        "tipo",
        "verificado_em"
      ],
      "properties": {
        "nome": {
          "type": "string",
          "minLength": 1,
          "description": "Nome da instituição ou da norma/legislação."
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://",
          "description": "URL canônica (site institucional ou texto oficial da norma)."
        },
        "descricao": {
          "type": "string",
          "minLength": 1,
          "description": "Descrição objetiva, em português."
        },
        "tipo": {
          "type": "string",
          "description": "Tipo de item do ecossistema brasileiro. Cada item tem exatamente um tipo; use tags para aspectos secundários.",
          "enum": [
            "instituicao",
            "legislacao"
          ]
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Tags livres para aspectos secundários."
        },
        "verificado_em": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Data da última verificação manual do item (AAAA-MM-DD)."
        }
      }
    }
  }
}
